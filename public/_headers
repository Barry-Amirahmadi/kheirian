# Cloudflare Pages reads this file from the root of the deployed output.
#
# Every matching rule is APPLIED AND MERGED -- there is no "most specific
# rule wins". A Cache-Control under `/*` therefore concatenates onto the
# one under `/videos/*`, producing the contradictory
#   `max-age=31536000, immutable, public, max-age=0, must-revalidate`
# that shipped in the first deploy. So `/*` carries security headers only,
# and Cache-Control appears exactly once per path.
#
# HTML needs no rule: Pages already defaults it to must-revalidate, which
# is what keeps a redeploy visible immediately.

# Content-hashed build assets can never change under a given URL.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The hero video is 3.2 MB and is essentially the whole first-load budget.
# Caching it for a year is what makes a repeat visit cheap. The filename is
# bumped by hand if the video is ever re-encoded.
/videos/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
